SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL="jdbc:mysql://localhost:8889/test_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DATABASE_USERNAME=quicktest
DATABASE_PASSWORD=quicktest
DEMO_SEED=true
VITE_API_URL=http://localhost:8080
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TIMEOUT_SECONDS=180
BACKEND_URL=http://localhost:8080
WORKSPACE_WORKERS=true
LEGACY_API_ENABLED=false
MOBILE_FULLSCREEN_VALIDATED=false
SECURE_COOKIES=false
MAIL_ADAPTER=local
# Railway: MAIL_ADAPTER=resend; configure a verified sender domain and HTTPS FRONTEND_URL.
RESEND_API_KEY=
MAIL_FROM=examai@localhost
MAIL_ALLOWED_DOMAINS=example.test,quicktest.local,examai.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
SMTP_TEST_CONNECTION=false
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe secrets and prices belong only on the backend, never VITE_*.
# Keep test and live in separate environments/databases; live requires explicit STRIPE_MODE=live.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ExamAI Pro: recurring 8.00 EUR, interval month, interval_count 1.
STRIPE_PRO_MONTH_PRICE_ID=
# Optional legacy annual price: only retain for existing yearly subscriptions.
STRIPE_PRO_YEAR_PRICE_ID=
BILLING_FIXTURES=false
BILLING_FREE_GROUP_LIMIT=1
BILLING_FREE_ACTIVE_ASSIGNMENT_LIMIT=5
BILLING_FREE_AI_CREDITS=10
BILLING_PRO_GROUP_LIMIT=20
BILLING_PRO_ACTIVE_ASSIGNMENT_LIMIT=100
BILLING_PRO_AI_CREDITS=100
# Compose uses isolated ports and clearly labeled offline adapters.
COMPOSE_MYSQL_PORT=8890
COMPOSE_API_PORT=8082
COMPOSE_FRONTEND_PORT=5174
COMPOSE_AI_PROVIDER=mock
COMPOSE_MAIL_ADAPTER=local
COMPOSE_SMTP_PORT=1025
